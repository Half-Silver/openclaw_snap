#!/bin/sh -e
# OpenClaw Snap Configuration Hook
# This script is triggered whenever the snap configuration is updated
# (e.g., via 'snap set openclaw port=12345').

# Get the configured settings
PORT=$(snapctl get port)
BIND=$(snapctl get bind)
REMOTE_HTTP_UI=$(snapctl get remote-http-ui)

if [ -n "$PORT" ] || [ -n "$BIND" ] || [ -n "$REMOTE_HTTP_UI" ]; then
  # If configuration has changed, restart the gateway service to apply the change
  echo "Restarting OpenClaw services to apply configuration changes (port: $PORT, bind: $BIND, remote-http-ui: $REMOTE_HTTP_UI)"
  snapctl restart openclaw.gateway
  snapctl restart openclaw.node
fi

# CT Engine Integration
# Auto-enable ct-engine sidecar when a callback URL is configured
CT_CALLBACK_URL=$(snapctl get ct-callback-url)
if [ -n "$CT_CALLBACK_URL" ]; then
    snapctl start --enable openclaw.ct-engine 2>/dev/null || true
    # Restart ct-engine so it picks up the new config via snapctl
    snapctl restart openclaw.ct-engine 2>/dev/null || true
fi
