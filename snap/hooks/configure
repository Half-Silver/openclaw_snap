#!/bin/sh -e
# OpenClaw Snap Configuration Hook
# Bridging 'snap set' to the internal .env configuration.

# 1. Ensure the config directory exists and is accessible
CONFIG_DIR="$SNAP_COMMON/.openclaw"
mkdir -p "$CONFIG_DIR"
chmod 777 "$CONFIG_DIR" 2>/dev/null || true

ENV_FILE="$CONFIG_DIR/.env"
touch "$ENV_FILE"
chmod 644 "$ENV_FILE" 2>/dev/null || true

# --- Token Synchronization ---
# Generate a shared token for gateway and node if it doesn't exist.
# This avoids the 'token missing' error on local node connection.
python3 << 'EOF'
import os, json, secrets

config_dir = os.environ.get('SNAP_COMMON') + '/.openclaw'
env_path = os.path.join(config_dir, '.env')
node_path = os.path.join(config_dir, 'node.json')

# Try to find existing token
token = ''
if os.path.exists(env_path):
    with open(env_path) as f:
        for line in f:
            if line.startswith('OPENCLAW_GATEWAY_TOKEN='):
                token = line.split('=', 1)[1].strip()
                break

if not token and os.path.exists(node_path):
    try:
        with open(node_path) as f:
            data = json.load(f)
            token = data.get('token', '')
    except:
        pass

if not token:
    token = secrets.token_hex(16)

# Write to .env
lines = []
if os.path.exists(env_path):
    with open(env_path) as f:
        lines = [l for l in f if not l.startswith('OPENCLAW_GATEWAY_TOKEN=')]
lines.append(f'OPENCLAW_GATEWAY_TOKEN={token}\n')
with open(env_path, 'w') as f:
    f.writelines(lines)

# Write to node.json
data = {'version': 1, 'nodeId': 'node-001'}
if os.path.exists(node_path):
    try:
        with open(node_path) as f:
            data = json.load(f)
    except:
        pass
data['token'] = token
with open(node_path, 'w') as f:
    json.dump(data, f)
 
# Also write to gateway.token for the sidecar status command
with open(os.path.join(config_dir, 'gateway.token'), 'w') as f:
    f.write(token)
EOF


# Helper to apply snap config to .env

apply_config() {
    snap_key="$1"
    env_key="$2"
    value=$(snapctl get "$snap_key")
    
    if [ -n "$value" ]; then
        # Remove existing entry and append new one
        sed -i "/^${env_key}=/d" "$ENV_FILE"
        echo "${env_key}=${value}" >> "$ENV_FILE"
    fi
}

# --- Service Toggles ---
handle_service() {
    service_key="$1" # e.g. gateway-service
    service_name="$2" # e.g. gateway
    status=$(snapctl get "$service_key")
    
    if [ "$status" = "enabled" ]; then
        snapctl start --enable "all-dev-openclaw.$service_name" 2>/dev/null || true
    elif [ "$status" = "disabled" ]; then
        snapctl stop --disable "all-dev-openclaw.$service_name" 2>/dev/null || true
    fi
}

handle_service "gateway-service" "gateway"
handle_service "node-service" "node"

# --- Network & Core ---
PORT=$(snapctl get port)
BIND=$(snapctl get bind)
REMOTE_HTTP_UI=$(snapctl get remote-http-ui)

# Update model in openclaw.json
python3 << 'EOF'
import os, json, subprocess

config_dir = os.environ.get('SNAP_COMMON') + '/.openclaw'
openclaw_json_path = os.path.join(config_dir, 'openclaw.json')

def get_config(key):
    try:
        res = subprocess.run(['snapctl', 'get', key], capture_output=True, text=True)
        return res.stdout.strip()
    except:
        return ''

model = get_config('model')
telegram_token = get_config('telegram-bot-token')

if model or telegram_token:
    data = {}
    if os.path.exists(openclaw_json_path):
        try:
            with open(openclaw_json_path) as f:
                data = json.load(f)
        except:
            pass
            
    if model:
        if 'agents' not in data:
            data['agents'] = {}
        if 'defaults' not in data['agents']:
            data['agents']['defaults'] = {}
        if 'model' not in data['agents']['defaults']:
            data['agents']['defaults']['model'] = {}
        data['agents']['defaults']['model']['primary'] = model
        
    if telegram_token:
        if 'channels' not in data:
            data['channels'] = {}
        if 'telegram' not in data['channels']:
            data['channels']['telegram'] = {}
        data['channels']['telegram']['enabled'] = True
        data['channels']['telegram']['botToken'] = telegram_token
        
    with open(openclaw_json_path, 'w') as f:
        json.dump(data, f, indent=2)
EOF

# --- AI Provider Keys ---
apply_config "openai-api-key" "OPENAI_API_KEY"
apply_config "anthropic-api-key" "ANTHROPIC_API_KEY"
apply_config "gemini-api-key" "GEMINI_API_KEY"
apply_config "openrouter-api-key" "OPENROUTER_API_KEY"

# --- Messaging Channels ---
# Telegram is handled by the Python script above to write to openclaw.json
apply_config "discord-bot-token" "DISCORD_BOT_TOKEN"
apply_config "slack-bot-token" "SLACK_BOT_TOKEN"
apply_config "slack-app-token" "SLACK_APP_TOKEN"

# --- Tools & Search ---
apply_config "brave-api-key" "BRAVE_API_KEY"
apply_config "perplexity-api-key" "PERPLEXITY_API_KEY"
apply_config "firecrawl-api-key" "FIRECRAWL_API_KEY"

# --- Voice ---
apply_config "elevenlabs-api-key" "ELEVENLABS_API_KEY"

# --- System ---
apply_config "log-level" "LOG_LEVEL"

# 2. Restart services if core networking or model changed
if [ -n "$PORT" ] || [ -n "$BIND" ] || [ -n "$REMOTE_HTTP_UI" ]; then
    echo "Restarting OpenClaw to apply changes..."
    snapctl restart all-dev-openclaw.gateway 2>/dev/null || true
    snapctl restart all-dev-openclaw.node 2>/dev/null || true
fi

# 3. CT Engine Integration
CT_CALLBACK_URL=$(snapctl get ct-callback-url)
if [ -n "$CT_CALLBACK_URL" ]; then
    snapctl start --enable all-dev-openclaw.ct-engine 2>/dev/null || true
    snapctl restart all-dev-openclaw.ct-engine 2>/dev/null || true
else
    snapctl stop --disable all-dev-openclaw.ct-engine 2>/dev/null || true
fi
