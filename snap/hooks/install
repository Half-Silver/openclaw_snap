#!/bin/sh
# OpenClaw Snap Install Hook

# Create shared config directory immediately
CONFIG_DIR="$SNAP_COMMON/.openclaw"
mkdir -p "$CONFIG_DIR"
chmod 777 "$CONFIG_DIR" 2>/dev/null || true

# Validate required network interfaces for sideloaded appliance installs.
SNAP_NAME="${SNAP_NAME:-all-dev-openclaw}"
MISSING_PLUGS=""
for plug in network network-bind; do
  snapctl connect "${SNAP_NAME}:${plug}" 2>/dev/null || true
  if ! snapctl is-connected "$plug" 2>/dev/null; then
    MISSING_PLUGS="$MISSING_PLUGS ${SNAP_NAME}:${plug}"
  fi
done
if [ -n "$MISSING_PLUGS" ]; then
  snapctl set-health --code=missing-network-plugs blocked "Required network interface(s) disconnected:${MISSING_PLUGS}. Run: sudo snap connect ${SNAP_NAME}:network; sudo snap connect ${SNAP_NAME}:network-bind" 2>/dev/null || true
else
  snapctl set-health okay 2>/dev/null || true
fi

# Initialize default configuration
snapctl set gateway-service="enabled"
snapctl set node-service="enabled"
snapctl set model="openrouter/auto"
snapctl set port=3000
snapctl set bind="lan"
snapctl set remote-http-ui=true
snapctl set log-level="info"

# CT integration defaults
snapctl set ct-callback-url=""
snapctl set ct-snap-name="all-dev-openclaw"
snapctl set ct-node-id=""
snapctl set ct-deployment-id=""

echo "OpenClaw (ALL Edition) installed successfully."
echo "Shared config:  $SNAP_COMMON/.openclaw/"
echo "Dashboard:      http://<device-ip>:3000"
echo "Get Token:      all-dev-openclaw.get-token"
echo "Configure via:  sudo snap set all-dev-openclaw openai-api-key=..."
