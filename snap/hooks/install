#!/bin/sh
# OpenClaw Snap Install Hook

# Create shared config directory immediately
CONFIG_DIR="$SNAP_COMMON/.openclaw"
mkdir -p "$CONFIG_DIR"
chmod 777 "$CONFIG_DIR" 2>/dev/null || true

# Initialize default configuration
snapctl set port=3000
snapctl set bind="lan"
snapctl set remote-http-ui=true

# CT integration defaults
snapctl set ct-callback-url=""
snapctl set ct-snap-name="all-dev-openclaw"
snapctl set ct-node-id=""
snapctl set ct-deployment-id=""

echo "OpenClaw (ALL Edition) installed successfully."
echo "Shared config:  $SNAP_COMMON/.openclaw/"
echo "Dashboard:      http://<device-ip>:3000"
echo "Get Token:      all-dev-openclaw.get-token"
echo "Configure via:  sudo snap set all-dev-openclaw openai-api-key=..."

